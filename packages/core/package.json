{
  "name": "@webflowd/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./db": "./src/db/index.ts",
    "./crypto": "./src/crypto/index.ts",
    "./tenancy": "./src/tenancy/index.ts",
    "./audit": "./src/audit/index.ts",
    "./security": "./src/security/index.ts"
  },
  "scripts": {
