# =============================================================================
# Webflow'd AI Admin Assistant — environment variables
# Copy to `.env` for local dev and set real values in Netlify env for deploys.
# NEVER commit a real `.env`. Every secret below is required in production
# unless marked optional. Values here are placeholders only.
# =============================================================================

# --- App -------------------------------------------------------------------
APP_BASE_URL=http://localhost:8888
NODE_ENV=development
# Comma-separated origins allowed to call the public chat-widget endpoint.
WIDGET_ALLOWED_ORIGINS=http://localhost:8888

# --- Database (Neon Postgres) ----------------------------------------------
# Pooled connection string for serverless functions.
DATABASE_URL=postgres://user:password@ep-xxx.eu-west-2.aws.neon.tech/webflowd?sslmode=require
# Direct (non-pooled) URL used by drizzle-kit for migrations.
DATABASE_URL_UNPOOLED=postgres://user:password@ep-xxx.eu-west-2.aws.neon.tech/webflowd?sslmode=require

# --- Auth0 -----------------------------------------------------------------
AUTH0_DOMAIN=webflowd.eu.auth0.com
AUTH0_AUDIENCE=https://api.webflowd.com
AUTH0_CLIENT_ID=your_spa_client_id
# Optional: only if you mint an M2M token for backend-initiated calls.
# AUTH0_M2M_CLIENT_ID=
# AUTH0_M2M_CLIENT_SECRET=

# --- Token encryption (AES-256-GCM) ----------------------------------------
# 32-byte key, base64-encoded. Generate: `openssl rand -base64 32`.
# In production, source this from a KMS/secret manager, not plain env.
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_base64_32
# Integer; bump when rotating keys. Old keys kept in TOKEN_ENCRYPTION_KEYS.
TOKEN_ENCRYPTION_KEY_VERSION=1
# Optional JSON map of retired keys for decryption during rotation:
# {"0":"<old base64 key>"}
# TOKEN_ENCRYPTION_KEYS={}

# --- Anthropic -------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxx
ANTHROPIC_MODEL=claude-sonnet-5

# --- Google (Calendar + Gmail + Business Profile) --------------------------
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Audience configured on the Pub/Sub push subscription (OIDC token) used to
# verify Gmail / Google Business push notifications.
GOOGLE_PUBSUB_VERIFICATION_AUDIENCE=https://webflowd.com/webhooks/gmail
# Shared secret the Google Business Profile ingestion layer sends in the
# x-gbp-token header to authenticate inbound-message webhooks.
GBP_INGEST_SECRET=REPLACE_WITH_random_hex

# --- Microsoft Graph (Outlook Calendar + Mail) -----------------------------
MS_CLIENT_ID=your_ms_app_id
MS_CLIENT_SECRET=your_ms_client_secret
MS_TENANT=common
# Random secret echoed back in Graph change notifications for verification.
MS_WEBHOOK_CLIENT_STATE=REPLACE_WITH_random_hex

# --- SendGrid (outbound email + inbound parse) -----------------------------
SENDGRID_API_KEY=SG.xxx
# Verified platform "from" address used by the lifecycle cron (reminders,
# review requests) which runs across tenants.
SENDGRID_FROM=hello@webflowd.com
# Shared secret embedded in the inbound-parse webhook URL/path.
SENDGRID_INBOUND_SECRET=REPLACE_WITH_random_hex

# --- Twilio (SMS / WhatsApp / Voice / missed-call) -------------------------
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Optional default numbers (per-tenant numbers stored in DB).
# TWILIO_SMS_FROM=
# TWILIO_WHATSAPP_FROM=whatsapp:+44xxx
# Exact public URLs Twilio POSTs the voice status / recording callbacks to
# (used for signature validation when behind a proxy that rewrites the URL).
# TWILIO_VOICE_WEBHOOK_URL=https://webflowd.com/webhooks/twilio/voice
# TWILIO_RECORDING_WEBHOOK_URL=https://webflowd.com/webhooks/twilio/recording
# Public origin (scheme + host) used to build + verify the turn-based voice
# receptionist callback URLs when behind a rewriting proxy.
# TWILIO_PUBLIC_BASE_URL=https://webflowd.com

# --- ElevenLabs (custom receptionist voice — optional, future) --------------
# Set this once you have an ElevenLabs account to enable custom voices in the
# Phone settings. Until it's set, calls use the selected Twilio (Polly) voice.
# ELEVENLABS_API_KEY=

# --- Stripe (deposits / invoices) ------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Inngest (background jobs + cron) --------------------------------------
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=signkey-xxx
# Optional default review link used in review-request messages.
# DEFAULT_REVIEW_LINK=https://g.page/r/your-review-link

# --- Voice (later phase; optional) -----------------------------------------
# DEEPGRAM_API_KEY=
# ELEVENLABS_API_KEY=

# --- Signed-in web app (packages/web, Vite) --------------------------------
# These are PUBLIC (bundled into client JS). Safe to expose; not secrets.
VITE_AUTH0_DOMAIN=webflowd.eu.auth0.com
VITE_AUTH0_CLIENT_ID=your_spa_client_id
VITE_AUTH0_AUDIENCE=https://api.webflowd.com
# Optional: leave blank for same-origin API calls via Netlify redirects.
VITE_API_BASE=
